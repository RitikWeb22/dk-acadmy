# Node dependencies
node_modules/
*/node_modules/
**/node_modules/

# Environment files - strictly ignored
.env
.env*
*.env
!.env.example
*/**/.env
*/**/.env*
!*/**/.env.example

# Production builds
/dist/
/build/
frontend/dist/
frontend/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript / Vite temp cache
*.tsbuildinfo
.vite-temp/
**/node_modules/.tmp/

# Backend generated static distribution (compiled automatically by build-unified from frontend/dist)
backend/public/*
backend/public/**/*
!backend/public/uploads/
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# Documentation & Reports are tracked
!*.md
!**/*.md



