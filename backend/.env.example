# Server Environment Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://dk-acadmy.vercel.app

# MongoDB Database Connection
MONGO_URI=mongodb://localhost:27017/dk_academy_jee

# JWT Authentication (Min 32 characters required)
JWT_SECRET=replace_with_at_least_32_characters_random_hex_string
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway & Webhook Signature
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret_min32

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# LiveKit Video Streaming (Optional)
LIVEKIT_URL=wss://your-livekit-url.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Google Gemini AI Math OCR & KaTeX Reconstruction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Redis Connection (Optional - Enables PM2 Cluster Pub/Sub and High-Performance Caching)
REDIS_URL=redis://default:password@host:port

# Hostinger SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@dkacademyjee.com
SMTP_PASS=your_hostinger_email_password
SMTP_FROM=info@dkacademyjee.com
SMTP_FROM_NAME=DK Academy JEE

# Meta WhatsApp Cloud API (Free 1,000 conversations/month)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

