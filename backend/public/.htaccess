# ==============================================================================
# DK Academy — LiteSpeed Web Server (Hostinger) Performance & Security Config
# ==============================================================================

<IfModule LiteSpeed>
    RewriteEngine On

    # 1. Disable LiteSpeed Bot Protection / Human Verification Checkbox (reCAPTCHA)
    RewriteRule .* - [E=verifycaptcha:off]

    # 2. Prevent LiteSpeed from aborting backend connection on client lag or long response
    RewriteRule .* - [E=noabort:1]

    # 3. Increase / Bypass LiteSpeed Connection Timeout (fixes 408 Request Time-out)
    RewriteRule .* - [E=noconntimeout:1]
</IfModule>

<IfModule mod_headers.c>
    Header set Connection "keep-alive"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>
